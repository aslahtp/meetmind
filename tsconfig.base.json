{
  // Shared compiler options. Each folder's tsconfig.json extends this one.
  // Everything under electron/, renderer/, extension/, tests/ and scripts/ is TypeScript and fully strict
  // (ESLint also bans `any`). The few remaining .js files (scripts run without a TS runner,
  // Tailwind/PostCSS config) are not part of any TypeScript project.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": []
  }
}
