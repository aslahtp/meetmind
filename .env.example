# Google Cloud Speech-to-Text API Key
# Create at: https://console.cloud.google.com/apis/credentials
# Enable: Cloud Speech-to-Text API
GOOGLE_API_KEY=your_google_cloud_api_key

# Google Gemini API Key
# Get at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Notion Integration Token
# Create at: https://www.notion.so/my-integrations
# Format: secret_xxxxxxxxxxxx
NOTION_TOKEN=secret_xxx

# Notion Database ID
# Found in your database URL: notion.so/workspace/{DATABASE_ID}?v=...
NOTION_DATABASE_ID=your_database_id

# Groq API Key (optional; used for both Groq speech-to-text and Groq note generation)
# Get at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# Sarvam AI API Key (optional STT provider)
# Get at: https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key
