{
  "name": "meetmind",
  "version": "1.0.0",
  "description": "AI meeting notes — transcribe, summarize, and upload to Notion",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"cross-env NODE_ENV=development electron .\"",
    "dev:renderer": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "build": "vite build && electron-builder --win",
    "build:renderer": "vite build",
    "build:electron": "electron-builder --win",
    "build:ext": "cd extension && powershell Compress-Archive -Path * -DestinationPath ../dist/meetmind-extension.zip -Force",
    "preview": "vite preview",
    "generate-icons": "node scripts/generate-icons.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@notionhq/client": "^2.2.15",
    "better-sqlite3": "^9.6.0",
    "electron-store": "^8.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5"
  },
  "build": {
    "extends": null
  }
}
