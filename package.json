{
  "name": "meetmind",
  "version": "4.16.0",
  "description": "Open-source AI meeting notes app for Windows, macOS and Linux: record Google Meet and Zoom calls, transcribe with AssemblyAI, Google STT, Sarvam AI or Groq, summarize with Gemini, Groq or Claude, and sync to Notion.",
  "keywords": [
    "ai-meeting-notes",
    "meeting-notes",
    "meeting-transcription",
    "meeting-minutes",
    "meeting-summary",
    "ai-note-taker",
    "speech-to-text",
    "transcription",
    "speaker-diarization",
    "google-meet",
    "zoom",
    "notion",
    "gemini",
    "assemblyai",
    "sarvam-ai",
    "indic-languages",
    "electron",
    "windows",
    "macos",
    "linux",
    "chrome-extension",
    "otter-alternative"
  ],
  "homepage": "https://aslahtp.github.io/meetmind/",
  "bugs": {
    "url": "https://github.com/aslahtp/meetmind/issues"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/aslahtp/meetmind.git"
  },
  "main": "electron/main.js",
  "desktopName": "meetmind.desktop",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "predev": "pnpm run generate-icons && pnpm run build:ext",
    "dev": "concurrently \"vite\" \"cross-env NODE_ENV=development electron .\"",
    "dev:renderer": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "prebuild": "pnpm run generate-icons && pnpm run build:ext",
    "build": "vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --config electron-builder.yml --publish never",
    "build:renderer": "vite build",
    "build:electron": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --config electron-builder.yml",
    "build:dir": "vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --dir --config electron-builder.yml",
    "prebuild:mac": "pnpm run generate-icons && pnpm run build:ext",
    "build:mac": "vite build && electron-builder --mac --arm64 --x64 --config electron-builder.yml --publish never",
    "build:mac:dir": "vite build && electron-builder --mac --dir --config electron-builder.yml",
    "prebuild:linux": "pnpm run generate-icons && pnpm run build:ext",
    "build:linux": "vite build && electron-builder --linux --x64 --config electron-builder.yml --publish never",
    "build:linux:dir": "vite build && electron-builder --linux --x64 --dir --config electron-builder.yml",
    "fetch-ffmpeg": "node scripts/fetch-ffmpeg.js",
    "build:ext": "node scripts/build-extension.js",
    "preview": "vite preview",
    "generate-icons": "node scripts/generate-icons.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.22.0",
    "@google/generative-ai": "^0.24.1",
    "@notionhq/client": "^2.3.0",
    "assemblyai": "^4.41.7",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.11",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^176.0.0",
    "ical.js": "^2.2.1",
    "koffi": "^3.3.3",
    "lucide-react": "^1.61.0",
    "partial-json": "^0.1.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remend": "^1.4.0",
    "sql.js": "^1.15.1",
    "uuid": "^14.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/typography": "^0.5.20",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "electron": "^44.8.0",
    "electron-builder": "^26.17.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.30",
    "rcedit": "^5.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.4",
    "vitest": "^5.0.5"
  },
  "build": {
    "extends": "./electron-builder.yml"
  }
}
