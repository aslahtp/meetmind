{
  "name": "meetmind",
  "version": "2.6.2",
  "description": "AI meeting notes — transcribe, summarize, and upload to Notion",
  "repository": {
    "type": "git",
    "url": "https://github.com/aslahtp/meetmind.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "predev": "npm run generate-icons && npm run build:ext",
    "dev": "concurrently \"vite\" \"cross-env NODE_ENV=development electron .\"",
    "dev:renderer": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "prebuild": "npm run generate-icons && npm run build:ext",
    "build": "vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --config electron-builder.yml",
    "build:renderer": "vite build",
    "build:electron": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --config electron-builder.yml",
    "build:dir": "vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --dir --config electron-builder.yml",
    "build:ext": "node scripts/build-extension.js",
    "preview": "vite preview",
    "generate-icons": "node scripts/generate-icons.js"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.14.0",
    "@google/generative-ai": "^0.21.0",
    "@notionhq/client": "^2.2.15",
    "assemblyai": "^4.26.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^176.0.0",
    "lucide-react": "^1.31.0",
    "sql.js": "^1.11.0",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.49",
    "rcedit": "^5.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5"
  },
  "build": {
    "extends": "./electron-builder.yml"
  }
}
