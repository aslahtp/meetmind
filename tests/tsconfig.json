{
  // Vitest suite (ESM on Node). Imports the sources under electron/ and renderer/ directly.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    // Renderer sources `import type` from @shared (erased at runtime, so Vitest needs no alias).
    "paths": { "@shared": ["../electron/shared"], "@shared/*": ["../electron/shared/*"] }
  },
  "include": ["./**/*", "../renderer/global.d.ts"]
}
